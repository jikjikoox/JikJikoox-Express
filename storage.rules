rules_version = '2';

// Règles Firebase Storage — JikJikoox Express.
// Les photos de livraison utilisent Supabase Storage privé et des URLs signées
// émises par l'Edge Function delivery-proof. Aucun upload client direct Firebase.
service firebase.storage {
  match /b/{bucket}/o {
    // Refus global par défaut.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isVerifiedSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Legacy Firebase proof path is intentionally disabled.
    // Delivery proof files must go through the authenticated Supabase Edge Function
    // and its short-lived signed upload URL; Admin SDK operations bypass rules.
    match /delivery_proofs/{courierId}/{missionId}/{fileName} {
      allow read, write: if false;
    }

    // Courier avatars: private, owner-only, constrained to image files <= 2 MB.
    match /courier_avatars/{courierId}/{fileName} {
      allow read: if isVerifiedSignedIn()
        && isValidId(courierId)
        && request.auth.uid == courierId;

      allow create, update: if isVerifiedSignedIn()
        && isValidId(courierId)
        && request.auth.uid == courierId
        && fileName.matches('^[a-zA-Z0-9_\\-]+\\.(jpg|jpeg|png|webp)$')
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];

      allow delete: if false;
    }
  }
}
