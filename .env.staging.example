# JikJikoox Express — variables frontend de staging uniquement
# Copier ce fichier vers .env.staging puis remplacer chaque valeur REPLACE_ME.
# Ne jamais placer ici de secret Firebase Admin ou Supabase service_role.

VITE_APP_ENV=staging
APP_URL=https://staging-livraison.jikjikoox.com

# Supabase Express staging déjà provisionné
VITE_SUPABASE_FUNCTIONS_URL=https://bwicndbbxvthbddiacks.supabase.co/functions/v1

# Firebase staging — projet confirmé. Relever les autres valeurs dans Firebase Console.
VITE_FIREBASE_PROJECT_ID=jikjikoox-express-staging
VITE_FIREBASE_API_KEY=REPLACE_ME_FIREBASE_WEB_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_ME_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_ME_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_ME_FIREBASE_APP_ID
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Facultatif : clé Web Push VAPID dédiée au projet Firebase staging
# VITE_FIREBASE_VAPID_KEY=REPLACE_ME_FIREBASE_VAPID_KEY
