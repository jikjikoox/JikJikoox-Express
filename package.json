{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "start": "node server.js",
    "postinstall": "vite build",
    "build": "vite build",
    "build:staging": "node scripts/validate-staging-env.mjs .env.staging && vite build --mode staging",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules",
    "validate:staging": "node scripts/validate-staging-env.mjs",
    "validate:staging:selftest": "node scripts/validate-staging-env.mjs --self-test",
    "test:security": "tsx tests/security.logic.test.ts",
    "test:supabase": "tsx tests/supabase.integration.test.ts",
    "test:staging:harness": "tsx tests/staging.e2e.harness.test.ts",
    "test:emulator": "firebase emulators:exec \"node tests/firestore.rules.emulator.test.mjs\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.11.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
