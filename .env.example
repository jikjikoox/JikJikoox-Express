# ==============================================================================
# JikJikoox Express — Variables d'environnement (modèle sans secrets)
# ==============================================================================
# RÈGLE DE SÉCURITÉ :
# Ne jamais placer de clé Firebase Admin ou Supabase Service Role dans le frontend.
# Les variables préfixées VITE_ sont publiques côté navigateur.

# --- Frontend (Vite / Hostinger) ---
APP_URL="https://livraison.jikjikoox.com"

# URL de base des Supabase Edge Functions (ex: https://<project-ref>.supabase.co/functions/v1)
VITE_SUPABASE_FUNCTIONS_URL=""

# Configuration Firebase Web (projet existant : livraisonjikjikoox)
VITE_FIREBASE_PROJECT_ID="livraisonjikjikoox"
VITE_FIREBASE_AUTH_DOMAIN="livraisonjikjikoox.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="livraisonjikjikoox.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_VAPID_KEY=""

# ==============================================================================
# --- Backend uniquement (Supabase Edge Functions Secrets — JAMAIS dans le frontend) ---
# À configurer uniquement dans Supabase Dashboard / CLI (`supabase secrets set`) :
#
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# FIREBASE_PROJECT_ID=livraisonjikjikoox
# FIRESTORE_DATABASE_ID=
# FIREBASE_SERVICE_ACCOUNT_EMAIL=
# FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=
# ALLOWED_ORIGINS=https://livraison.jikjikoox.com,https://admin.jikjikoox.com
# INTERNAL_SYNC_SECRET=
# ==============================================================================
